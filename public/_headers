# Cloudflare serves ./dist straight from its edge, so these apply to every file.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000
  Speculation-Rules: "/speculation.json"
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# Rules for instant navigation: prerender a page when a link is hovered or pressed, prefetch the bar links. Served as a
# file because the CSP forbids inline scripts, and the inline form of the rules counts as one.
/speculation.json
  Content-Type: application/speculationrules+json
  Cache-Control: public, max-age=3600

# Pages: fresh for a minute, then served from the browser cache while it revalidates in the background. A second visit or a
# back/forward costs no network wait. A deploy shows within a minute for new visits and a few minutes at most for returning ones.
/
  Cache-Control: public, max-age=60, stale-while-revalidate=600
/projects
  Cache-Control: public, max-age=60, stale-while-revalidate=600
/projects/*
  Cache-Control: public, max-age=60, stale-while-revalidate=600
/writing
  Cache-Control: public, max-age=60, stale-while-revalidate=600
/writing/*
  Cache-Control: public, max-age=60, stale-while-revalidate=600
/experience
  Cache-Control: public, max-age=60, stale-while-revalidate=600
/colophon
  Cache-Control: public, max-age=60, stale-while-revalidate=600

# Hashed build output: never changes.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Unhashed files: revalidate each hour so an edit shows up quickly.
/og/*
  Cache-Control: public, max-age=3600
/Resume.pdf
  Cache-Control: public, max-age=3600
/favicon.svg
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400

# Files meant to be read by in-browser agents and feed readers.
/llms.txt
  Access-Control-Allow-Origin: *
/llms-full.txt
  Access-Control-Allow-Origin: *
/writing/feed.xml
  Access-Control-Allow-Origin: *
/writing/*.md
  Access-Control-Allow-Origin: *
/projects/*.md
  Access-Control-Allow-Origin: *
