---
import Arrow from "./Arrow.astro";
interface Props { href: string; external?: boolean; class?: string }
const { href, external = false, class: cls = "" } = Astro.props;
---

<a href={href} {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})} class:list={["inline-flex min-h-11 items-center gap-2 text-fg", cls]}>
  <span class="link"><slot /></span>
  <span aria-hidden="true" class:list={["arrow", external && "arrow-out"]}><Arrow dir={external ? "up-right" : "right"} /></span>
  {external && <span class="sr-only">(opens in new tab)</span>}
</a>
