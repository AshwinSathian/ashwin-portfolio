---
import { SITE } from "../data/site";
const LINKS = [
  { label: "Email", href: `mailto:${SITE.email}` },
  { label: "LinkedIn", href: SITE.linkedin, external: true },
  { label: "GitHub", href: SITE.github, external: true },
  { label: "Résumé", href: SITE.resumePath, external: true },
  { label: "Colophon", href: "/colophon" },
  { label: "RSS", href: "/writing/feed.xml" },
];
---

<footer class="relative z-10 border-t border-line bg-night">
  <div class="shell flex flex-col gap-2 py-6 text-meta text-fg-3 sm:flex-row sm:items-center sm:justify-between">
    <span>© {new Date().getFullYear()} {SITE.name}. Writing software since 2018.</span>
    <ul class="-mx-2 flex flex-wrap">
      {LINKS.map(({ label, href, external }) => (
        <li>
          <a href={href} {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})} class="flex min-h-11 items-center px-2 transition-colors duration-200 hover:text-fg">
            <span class="link">{label}</span>{external && <span class="sr-only"> (opens in new tab)</span>}
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>
