---
import { SITE } from "../data/site";
const { path = "" } = Astro.props;
const LINKS = [
  { label: "Projects", href: "/projects" },
  { label: "Experience", href: "/experience" },
  { label: "Writing", href: "/writing" },
];
const current = (href: string) => (path === href || path.startsWith(`${href}/`) ? "page" : undefined);
---

<header class="bar fixed inset-x-0 top-0 z-50 border-b border-line bg-night/80 backdrop-blur-md">
  <div class="shell flex h-16 items-center justify-between">
    <a href="/" aria-label={`${SITE.name}, home`} class="wordmark flex min-h-11 items-center text-[1.25rem] text-fg">
      Ashwin Sathian
    </a>

    <nav aria-label="Main" class="hidden items-center gap-8 md:flex">
      {LINKS.map(({ label, href }) => (
        <a href={href} aria-current={current(href)} class="flex min-h-11 items-center text-small text-fg-2 transition-colors duration-200 hover:text-fg aria-[current=page]:text-fg">
          <span class="link" aria-current={current(href)}>{label}</span>
        </a>
      ))}
      <a
        href={SITE.resumePath}
        target="_blank"
        rel="noopener noreferrer"
        class="flex min-h-11 items-center rounded-full bg-yellow px-5 font-display text-small font-semibold text-night transition-transform duration-300 ease-spring hover:-translate-y-0.5 active:translate-y-0"
      >
        Résumé<span class="sr-only"> (opens in new tab)</span>
      </a>
    </nav>

    <button
      type="button"
      id="menu-open"
      aria-haspopup="dialog"
      class="-mr-3 flex h-12 items-center gap-2.5 rounded-control px-3 text-small text-fg active:bg-surface-2 md:hidden"
    >
      Menu
      <span aria-hidden="true" class="flex flex-col gap-[5px]">
        <span class="block h-0.5 w-5 bg-fg"></span>
        <span class="block h-0.5 w-5 bg-fg"></span>
      </span>
    </button>
  </div>

  <!-- Native <dialog>: showModal() gives focus trapping, Escape and an inert page. -->
  <dialog id="menu" aria-label="Menu" class="menu-sheet md:hidden">
    <div aria-hidden="true" class="mx-auto mb-3 h-1 w-10 rounded-full bg-line-strong"></div>
    <nav class="flex flex-col">
      {[{ label: "Home", href: "/" }, ...LINKS].map(({ label, href }, i) => (
        <a
          href={href}
          aria-current={href === "/" ? (path === "" ? "page" : undefined) : current(href)}
          class="flex min-h-14 items-center justify-between border-b border-line font-display text-[1.75rem] font-bold tracking-[-0.03em] text-fg-2 active:text-fg aria-[current=page]:text-fg"
        >
          {label}
          <span aria-hidden="true" class:list={["h-3 w-3 rounded-full", ["bg-orange", "bg-yellow", "bg-teal", "bg-blue"][i]]}></span>
        </a>
      ))}
      <a href={SITE.resumePath} target="_blank" rel="noopener noreferrer" class="flex min-h-14 items-center justify-between border-b border-line font-display text-[1.75rem] font-bold tracking-[-0.03em] text-fg-2 active:text-fg">
        Résumé <span aria-hidden="true" class="arrow arrow-out text-fg-3">↗</span>
      </a>
    </nav>
    <button type="button" id="menu-close" class="mt-5 flex h-12 w-full items-center justify-center rounded-full bg-yellow font-display text-small font-semibold text-night">Close</button>
  </dialog>
</header>

<script>
  const menu = document.getElementById("menu") as HTMLDialogElement | null;
  document.getElementById("menu-open")?.addEventListener("click", () => menu?.showModal());
  document.getElementById("menu-close")?.addEventListener("click", () => menu?.close());
  // A click that lands on the dialog element itself is on the backdrop.
  menu?.addEventListener("click", (e) => e.target === menu && menu.close());
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => menu.close()));
</script>
