---
interface Props { title: string; tab: string; tone: "orange" | "yellow" | "teal" | "blue"; }
const { title, tab, tone } = Astro.props;
---

<header class="shell pb-12 pt-32 lg:pb-20 lg:pt-44">
  <p class:list={["pill load-rise mb-6", `tone-${tone}`]}>{tab}</p>
  <h1 class="load-rise max-w-5xl text-display-xl font-bold tracking-[-0.035em] [--d:80ms]">{title}</h1>
  <div class="load-rise mt-6 max-w-2xl text-fg-2 lg:mt-8 lg:text-[1.1875rem] [--d:200ms]"><slot /></div>
</header>
