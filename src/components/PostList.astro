---
import type { Post } from "../lib/posts";
import { postDate } from "../lib/posts";
interface Props { posts: Post[]; as?: "h2" | "h3" }
const { posts, as: Heading = "h2" } = Astro.props;
---

{posts.length > 0 && (
  <ul class="flex flex-col">
    {posts.map((post) => (
      <li>
        <a href={`/writing/${post.id}`} class="row reveal grid gap-x-8 gap-y-2 rounded-control border-t border-line py-7 md:grid-cols-[11rem_1fr_auto] md:items-baseline">
          <span class="text-meta tabular-nums text-fg-3">{postDate(post)}{post.data.draft && " · Draft"}</span>
          <span class="flex flex-col gap-2">
            <Heading class="text-[1.375rem] font-semibold leading-[1.2] tracking-[-0.01em] text-fg">{post.data.title}</Heading>
            <span class="max-w-2xl text-small text-fg-2">{post.data.description}</span>
            {post.data.tags.length > 0 && <span class="text-meta tabular-nums text-fg-3">{post.data.tags.join(" · ")}</span>}
          </span>
          <span class="text-meta tabular-nums text-fg-3">{post.readingTime} min</span>
        </a>
      </li>
    ))}
  </ul>
)}
