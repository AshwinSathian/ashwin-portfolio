{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ashwin-portfolio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // The only .html file in assets is the Google verification file; "none"
    // serves it at its exact path instead of redirecting to the extensionless URL.
    "html_handling": "none"
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "ashwin-portfolio-cache"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ashwin-portfolio"
    }
  ]
}
