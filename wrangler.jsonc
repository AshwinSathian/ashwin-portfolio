{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ashwin-portfolio",
  "compatibility_date": "2026-11-01",
  // Cloudflare serves ./dist straight from its edge. The Worker below answers
  // one path only, for Google Search Console ownership.
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    // /projects/weir serves projects/weir.html; /projects/weir/ redirects to it.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/google4e979ce58507a6a4.html"]
  }
}
